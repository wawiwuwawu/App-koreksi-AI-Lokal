generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "mysql"
}

model Lecturer {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  courses   Course[]
  createdAt DateTime @default(now())

  @@map("lecturer")
}

model Course {
  id         String   @id @default(cuid())
  code       String
  name       String
  lecturerId String
  lecturer   Lecturer @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  classes    Class[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([code, lecturerId])
  @@index([lecturerId])
  @@map("course")
}

model Class {
  id        String   @id @default(cuid())
  name      String
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, courseId])
  @@index([courseId])
  @@map("class")
}

model Task {
  id             String       @id @default(cuid())
  title          String
  rubric         String       @db.Text
  windowSize     Int          @default(3)
  duplicateScore Int          @default(50)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  assignments    Assignment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([title, classId])
  @@index([classId])
  @@map("task")
}

model Assignment {
  id                 String       @id @default(cuid())
  studentName        String
  fileName           String
  extractedText      String       @db.Text
  score              Int?
  feedback           String?      @db.Text
  plagiarismNote     String?      @db.Text
  driveFileUrl       String?
  status             String       @default("pending")
  errorMessage       String?      @db.Text
  isDuplicate        Boolean      @default(false)
  duplicateOfId      String?
  duplicateOf        Assignment?  @relation("AssignmentDuplicate", fields: [duplicateOfId], references: [id])
  duplicates         Assignment[] @relation("AssignmentDuplicate")
  duplicateReason    String?      @db.Text
  duplicateSimilarity Float?
  detectionSource    String?
  textHash           String?
  imageHashes        String?      @db.Text
  taskId             String
  task               Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([studentName, taskId])
  @@index([taskId])
  @@index([status])
  @@index([textHash])
  @@index([duplicateOfId])
  @@index([taskId, status])
  @@map("assignment")
}

model SystemConfig {
  id         String   @id @default("default")
  rubric     String   @db.Text
  windowSize Int      @default(3)
  updatedAt  DateTime @updatedAt

  @@map("system_config")
}
