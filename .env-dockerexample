# DATABASE_URL is automatically built inside docker-compose for container-to-container connection.
# If you need to access the database from your host machine (e.g. for running migrations or Prisma Studio locally),
# use this URL pointing to localhost and port 5436:
# DATABASE_URL="postgresql://gradely:gradely_secret@localhost:5436/grading_app?schema=public"

# LM Studio URL pointing to the host machine
LM_STUDIO_URL="http://host.docker.internal:1234/v1"
LM_STUDIO_MODEL="google/gemma-2-9b-it"

# Secret key for Google Sheets Webhook Verification
WEBHOOK_SECRET="local_grading_secret_token_abc123"

# PostgreSQL Container Credentials (used by db service in docker-compose)
POSTGRES_USER=gradely
POSTGRES_PASSWORD=gradely_secret
POSTGRES_DB=grading_app
